<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.1</Version>
    <Description>Pulsa's shared base layer for reusable AI features — every Pulsa package builds on Microsoft.Extensions.AI.Abstractions through this project, rather than each declaring the dependency independently.</Description>
    <PackageTags>pulsa;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

</Project>
