<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.0</Version>
    <Description>Pulsa's ffmpeg module — every Pulsa capability that needs ffmpeg, in one package: compose images and captions into a captioned, Ken Burns–animated video, pixelate a region of an image or a time range of a video, and prepare any audio for transcription. Host-agnostic.</Description>
    <PackageTags>pulsa;ffmpeg;video;ken-burns;redact;privacy;pixelate;transcription;audio</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" />
  </ItemGroup>

  <!-- The stage ports PulsaMedia implements (audio preparation for transcription) are defined in Pulsa. -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\Pulsa\Pulsa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulsa.Media.Tests" />
  </ItemGroup>

</Project>
