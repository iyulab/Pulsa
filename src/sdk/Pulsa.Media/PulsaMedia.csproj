<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.0</Version>
    <Description>Pulsa's ffmpeg module — every Pulsa capability that needs ffmpeg, in one package: compose images and captions into a captioned, Ken Burns–animated video, and pixelate regions of an image or a time range of a video — given a vision model, finding what to hide. Host-agnostic.</Description>
    <PackageTags>pulsa;ffmpeg;video;ken-burns;redact;privacy;pixelate</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" />
    <!-- The model role: a detector for redaction can be any vision model behind IChatClient. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulsa.Media.Tests" />
  </ItemGroup>

</Project>
